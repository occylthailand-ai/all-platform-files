# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://openthai:change_me@postgres:5432/openthaiai
DB_PASSWORD=change_me_in_production

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://:change_me@redis:6379/0
REDIS_PASSWORD=change_me
CELERY_BROKER_URL=redis://:change_me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change_me@redis:6379/1

# ── Security ──────────────────────────────────────────────────────
SECRET_KEY=GENERATE_WITH: python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_BIZ_MONTHLY=price_...

# ── AI APIs ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── App ───────────────────────────────────────────────────────────
FRONTEND_URL=https://app.openthaiai.com
DEBUG=false

# ── Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── Credits Config ────────────────────────────────────────────────
FREE_CREDITS=100
PRO_CREDITS=5000
BIZ_CREDITS=20000
CREDIT_COST_CONTENT=10
CREDIT_COST_VOICE=20
CREDIT_COST_SUMMARY=5
CREDIT_COST_AGENT=30

# ── Settlement Policy Gates ────────────────────────────────────────
# LIVE_MONEY_ENABLED is a requested-mode flag only, not a gate authority.
# All three gates (G1/G2/G3) must independently pass before any settlement.
# Setting this to true without valid G2 attestations still results in DENIED.
LIVE_MONEY_ENABLED=false

# 32-byte secret used to sign G2 attestation tokens (HMAC-SHA256).
# Rotate via ops channel; never commit the real value.
ATTESTATION_SECRET_KEY=GENERATE_WITH: python -c "import secrets; print(secrets.token_hex(32))"
